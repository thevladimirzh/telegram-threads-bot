# telegram-threads-bot — environment variables.
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# --- app (src/config.ts, Zod-validated) ---
# Telegram bot token from @BotFather.
BOT_TOKEN=
# Comma-separated Telegram user ids of global admins (manage /settings and chat connections).
ADMIN_IDS=
# PostgreSQL connection string, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Update delivery mode: polling (default) or webhook.
MODE=polling
# HTTP port for /health, /ready (and the webhook listener).
PORT=8080

# --- webhook mode only (MODE=webhook) ---
# Public HTTPS URL Telegram posts updates to.
WEBHOOK_URL=
# X-Telegram-Bot-Api-Secret-Token value for incoming webhook requests.
WEBHOOK_SECRET=

# --- database container (docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
